<?xml version="1.0" encoding="utf-8"?>
<!--
  pulse.xml
  ---------
  Repeating scale + alpha animation applied to the mic button while listening.
  Gives a gentle "heartbeat" effect to indicate active recording.
  Applied / cleared via AnimationUtils.loadAnimation() in MainActivity.
-->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:anim/accelerate_decelerate_interpolator">

    <!-- Scale outward then back -->
    <scale
        android:duration="700"
        android:fromXScale="1.0"
        android:fromYScale="1.0"
        android:pivotX="50%"
        android:pivotY="50%"
        android:repeatCount="infinite"
        android:repeatMode="reverse"
        android:toXScale="1.15"
        android:toYScale="1.15" />

    <!-- Fade slightly then back to full opacity -->
    <alpha
        android:duration="700"
        android:fromAlpha="1.0"
        android:repeatCount="infinite"
        android:repeatMode="reverse"
        android:toAlpha="0.75" />

</set>
